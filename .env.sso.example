# DSSO / OIDC example configuration
# Copy this file to .env.sso on the server and fill real values there.
# Never commit .env.sso.

AUTH_MODE=sso_local_roles
SSO_ENABLED=true

DSSO_DISCOVERY_URL=https://YOUR_DSSO_HOST/adfs/.well-known/openid-configuration
DSSO_AUTHORIZE_URL=https://YOUR_DSSO_HOST/adfs/oauth2/authorize
DSSO_CLIENT_ID=YOUR_CLIENT_ID
DSSO_CLIENT_SECRET=YOUR_CLIENT_SECRET
DSSO_REDIRECT_URI=https://YOUR_PUBLIC_DOMAIN/sso/callback
DSSO_SCOPE=openid
DSSO_TOKEN_ENDPOINT_AUTH_METHOD=client_secret_post
DSSO_CLOCK_SKEW_SECONDS=300
